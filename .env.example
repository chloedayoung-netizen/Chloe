# ---- Web Search (Serper.dev — Google 결과, 전체 웹) ----
# https://serper.dev  (가입 후 대시보드에서 API 키 발급, 무료 크레딧 제공)
SERPER_API_KEY=your-serper-api-key

# ---- LLM (OpenRouter, OpenAI 호환 API) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# OpenAI 호환 엔드포인트 (기본값 그대로 두면 됨)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 모델 ID. Structured Outputs(json_schema) 를 지원하는 모델을 사용하세요.
# 예: openai/gpt-4o-2024-08-06, openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-2024-08-06

# ---- Google Sheets ----
# Path to the service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Target spreadsheet ID (from the sheet URL: .../d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=your-spreadsheet-id
# Worksheet/tab name inside the spreadsheet
GOOGLE_SHEET_TAB=buyers
